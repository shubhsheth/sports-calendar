# PostHog Analytics
# Get your project API key from https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_your_key_here

# PostHog host (defaults to https://us.i.posthog.com if not set)
# Use https://eu.i.posthog.com for the EU cloud, or your self-hosted URL
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Calendar feed base URL. Optional override; defaults to the site's own origin
# + /calendar (Firebase Hosting rewrites /calendar/** to the feed function), so
# leave this empty in production. Set it only to point feeds at a different host.
VITE_CALENDAR_FEED_BASE_URL=

# Firebase web config (auth + personal calendars). All from the Firebase
# console → Project settings; these values are safe to expose in the client
# bundle. Leave unset to run without accounts — the auth UI hides and everything
# else works.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
