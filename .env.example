# PostHog Analytics
# Get your project API key from https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_your_key_here

# PostHog host (defaults to https://us.i.posthog.com if not set)
# Use https://eu.i.posthog.com for the EU cloud, or your self-hosted URL
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Edge Function base URL for live calendar subscription feeds.
# The deployed "calendar" function serves its Hono routes under /calendar/*, and
# the client appends "/<league>.ics" to this base.
# e.g. https://<project-ref>.supabase.co/functions/v1/calendar
VITE_CALENDAR_FEED_BASE_URL=

# Supabase project (auth + personal calendars). Both from the project's
# API settings; the anon key is safe to expose in the client bundle.
# Leave unset to run without accounts — auth UI hides and everything else works.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
